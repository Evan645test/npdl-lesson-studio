{
  "name": "npdl-studio-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/check-build.mjs",
    "smoke:next": "node scripts/smoke.mjs",
    "release:preview": "node scripts/release.mjs",
    "preview:releases": "node scripts/serve.mjs",
    "check:source": "node scripts/check-source.mjs"
  },
  "dependencies": {
    "docx": "9.7.1",
    "jspdf": "4.2.1",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "playwright-core": "1.61.1",
    "typescript": "5.8.3",
    "vite": "7.3.5",
    "vitest": "5.0.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "dompurify": "3.4.17"
  }
}
